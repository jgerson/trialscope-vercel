# Required
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=aws-us-east-1

# Recommended on a public deployment: visitors must enter this password
APP_PASSWORD=

# Copilot. On Vercel it runs through AI Gateway with the project's OIDC token; locally, run
# `vercel link` and `vercel env pull` (token lasts 12 hours) or set an AI Gateway key.
# AI_GATEWAY_API_KEY=
# COPILOT_MODEL=anthropic/claude-sonnet-5.5
# Optional: setting this calls Anthropic directly instead of AI Gateway (model id then claude-sonnet-5-5)
# ANTHROPIC_API_KEY=

# Optional: block note edits
# READ_ONLY=true
